<Window x:Class="STool.Modules.Clipboard.ClipboardPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:STool.Core"
        Style="{StaticResource ModernWindow}"
        core:ModernWindowChrome.ShowTopmostButton="True"
        core:ModernWindowChrome.TitleBarExtraTopPadding="True"
        Title="剪贴板历史"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="440"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{StaticResource TransparentBrush}"
                                Padding="10">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="{StaticResource CornerRadiusMedium}"
                                    Padding="5">
                                <Border.Effect>
                                    <StaticResource ResourceKey="MenuShadow"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ModernFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="root"
                                Background="{StaticResource TransparentBrush}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter TargetName="root" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- 列表行:白色行块浮于画布,间隙分隔,无线条;悬停与键盘选中用浅蓝背景区分,选中额外显示主题色描边 -->
        <Style x:Key="ClipRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMedium}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ModernFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource CornerRadiusMedium}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageInfoBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
        </Style>

        <Style x:Key="ImageLargeBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
        </Style>

        <Style x:Key="ClipboardSearchSurface" TargetType="Border" BasedOn="{StaticResource ToolPanelToolbarSurface}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="218"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="Width" Value="Auto"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClipboardListScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{StaticResource TransparentBrush}"
                              Margin="0,6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Height="32"
                                           MinHeight="32">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbRoot"
                                                        Background="{StaticResource BorderBrush}"
                                                        CornerRadius="3"
                                                        Margin="3,3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10,52,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SegmentedContainer}"
                    HorizontalAlignment="Left">
                <Grid x:Name="tabSegmentGrid" Height="32" ClipToBounds="True">
                    <Border x:Name="tabSlider"
                            Style="{StaticResource SegmentedSlider}"
                            Width="{Binding ActualWidth, ElementName=tabAll}">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="tabSliderScale" ScaleX="1"/>
                                <TranslateTransform x:Name="tabSliderTransform"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="58"/>
                            <ColumnDefinition Width="Auto" MinWidth="58"/>
                            <ColumnDefinition Width="Auto" MinWidth="58"/>
                            <ColumnDefinition Width="Auto" MinWidth="58"/>
                            <ColumnDefinition Width="Auto" MinWidth="58"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="tabAll" Grid.Column="0" Style="{StaticResource SegmentedButton}" MinWidth="58" Tag="on" Content="全部" Click="Tab_Click"/>
                        <Button x:Name="tabText" Grid.Column="1" Style="{StaticResource SegmentedButton}" MinWidth="58" Content="文本" Click="Tab_Click"/>
                        <Button x:Name="tabImage" Grid.Column="2" Style="{StaticResource SegmentedButton}" MinWidth="58" Content="图像" Click="Tab_Click"/>
                        <Button x:Name="tabFile" Grid.Column="3" Style="{StaticResource SegmentedButton}" MinWidth="58" Content="文件" Click="Tab_Click"/>
                        <Button x:Name="tabFavorite" Grid.Column="4" Style="{StaticResource SegmentedButton}" MinWidth="58" Content="收藏" Click="Tab_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource ClipboardSearchSurface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Style="{StaticResource ToolIconSmall}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="{StaticResource TransparentBrush}"/>
                        </Canvas>
                    </Viewbox>

                    <Grid Grid.Column="1" Height="32" VerticalAlignment="Center">
                        <TextBlock x:Name="searchPlaceholder"
                                   Text="搜索，↑↓ 选择，Enter 粘贴"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Opacity="0.9"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSearch"
                                 Background="{StaticResource TransparentBrush}"
                                 BorderThickness="0"
                                 Padding="0"
                                 Height="32"
                                 FontSize="{StaticResource FontSizeBody}"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtSearch_TextChanged"/>
                    </Grid>

                    <Button x:Name="btnClearSearch"
                            Grid.Column="2"
                            Width="24"
                            Height="24"
                            Margin="8,0,0,0"
                            Padding="0"
                            Style="{StaticResource IconButton}"
                            ToolTip="清除搜索"
                            Visibility="Collapsed"
                            Click="BtnClearSearch_Click">
                        <Viewbox Style="{StaticResource ToolIconSmall}" Width="12" Height="12">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconX}"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="Enter 粘贴 · Ctrl+Enter 复制 · 双击粘贴 · 右键更多操作"
                   Style="{StaticResource HintText}" Margin="4,8,48,0"/>

        <!-- 列表 + 悬浮清空按钮 -->
        <Grid Grid.Row="1">
            <!-- 空状态 -->
            <StackPanel x:Name="emptyState"
                        Style="{StaticResource EmptyStateContainer}"
                        Visibility="Collapsed">
                <Border Width="68"
                        Height="68"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="18"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <StaticResource ResourceKey="PaneShadow"/>
                    </Border.Effect>
                    <Grid>
                        <Viewbox x:Name="emptyClipboardIcon"
                                 Width="30"
                                 Height="30"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconClipboard}"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="{StaticResource TransparentBrush}"
                                      Opacity="0.72"/>
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="emptySearchIcon"
                                 Width="30"
                                 Height="30"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconSearch}"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="{StaticResource TransparentBrush}"
                                      Opacity="0.72"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>
                <TextBlock x:Name="emptyTitle" Text="暂无记录" Style="{StaticResource EmptyStateTitle}"/>
                <TextBlock x:Name="emptyDescription" Text="复制内容会自动保存到剪贴板历史中" Style="{StaticResource EmptyStateDescription}"/>
            </StackPanel>

            <!-- 列表:虚拟化 ListBox(Recycling + 像素滚动,行高不等);保留 8px 细滚动条 -->
            <ListBox x:Name="itemsList"
                     Background="{StaticResource TransparentBrush}"
                     BorderThickness="0"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.ScrollChanged="ItemsList_ScrollChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_Scroll"
                                          Focusable="False"
                                          Padding="0,0,0,4"
                                          CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid ClipToBounds="False">
                                            <ScrollContentPresenter Margin="{TemplateBinding Padding}"
                                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource ClipboardListScrollBar}"
                                                       Margin="0,0,-9,0"
                                                       Background="{StaticResource TransparentBrush}"
                                                       Value="{TemplateBinding VerticalOffset}"
                                                       Maximum="{TemplateBinding ScrollableHeight}"
                                                       ViewportSize="NaN"
                                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ClipRow}"
                                MouseLeftButtonDown="Item_MouseLeftButtonDown">
                            <Border.Tag>
                                <Binding Path="Id"/>
                            </Border.Tag>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding FavoriteTooltip}" Click="MenuFavorite_Click"/>
                                    <MenuItem Header="另存为" Click="MenuSaveAs_Click" Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>
                                    <MenuItem Header="删除" Click="MenuDelete_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                    <Border Width="88" Height="72" Margin="0,0,12,0"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            CornerRadius="{StaticResource CornerRadiusSmall}"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                            MouseLeftButtonDown="ThumbPreview_MouseLeftButtonDown"
                                            ToolTip="预览图片">
                                        <Image Source="{Binding ImageSource}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Loaded="ThumbImage_Loaded"/>
                                    </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="图片" FontSize="{StaticResource FontSizeBody}"
                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DisplayText}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeContent}"
                                               LineHeight="20"
                                               MaxHeight="62"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding RelativeTime}" Style="{StaticResource HintText}"
                                                   ToolTip="{Binding FullTimestamp}" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding SourceApp}" Style="{StaticResource HintText}"
                                                   Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                        <Border Style="{StaticResource ImageLargeBadge}"
                                                Visibility="{Binding IsLargeImage, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="大图"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="{StaticResource FontWeightStrong}"/>
                                        </Border>
                                        <Border Style="{StaticResource ImageInfoBadge}"
                                                Margin="0,6,0,0">
                                            <TextBlock Text="{Binding ImageInfoText}"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource FavoriteButton}"
                                            Tag="{Binding FavoriteState}"
                                            ToolTip="{Binding FavoriteTooltip}"
                                            AutomationProperties.Name="{Binding FavoriteTooltip}"
                                            Click="FavoriteButton_Click"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding FavoriteGlyph}"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   LineHeight="{StaticResource FontSizeCaption}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 悬浮清空按钮 -->
            <Button x:Name="btnClearAll"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="0,0,4,4"
                    Width="40" Height="40"
                    Cursor="Hand"
                    ToolTip="清空全部" AutomationProperties.Name="清空剪贴板历史"
                    Click="BtnClearAll_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fab"
                                Background="{StaticResource SurfaceBrush}"
                                BorderThickness="0"
                                CornerRadius="20">
                            <Border.Effect>
                                <StaticResource ResourceKey="MenuShadow"/>
                            </Border.Effect>
                            <Viewbox Style="{StaticResource ToolIconLarge}">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="trashIcon"
                                          Data="{StaticResource IconTrash2}"
                                          Stroke="{StaticResource TextSecondaryBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="{StaticResource TransparentBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fab" Property="Background" Value="{StaticResource ErrorBrush}"/>
                                <Setter TargetName="fab" Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                <Setter TargetName="trashIcon" Property="Stroke" Value="{StaticResource OnPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 图片预览浮层:不压暗背景,图片本体带阴影直接浮在列表上,点击任意处或 Esc 关闭。 -->
        <Grid x:Name="imagePreviewOverlay"
              Grid.RowSpan="2"
              Background="{StaticResource TransparentBrush}"
              Visibility="Collapsed"
              MouseLeftButtonDown="ImagePreviewOverlay_MouseLeftButtonDown">
            <Border MaxWidth="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="ImagePreviewCard_MouseLeftButtonDown">
                <Border.Effect>
                    <StaticResource ResourceKey="MenuShadow"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource SurfaceAltBrush}"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Image x:Name="imagePreview"
                               MaxHeight="420"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <TextBlock x:Name="imagePreviewTitle"
                               Grid.Row="1"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeCaption}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
