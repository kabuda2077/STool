<Window x:Class="STool.Modules.Ocr.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:STool.Core"
        Style="{StaticResource ModernWindow}"
        core:ModernWindowChrome.TitleBarExtraTopPadding="True"
        Title="OCR 识别结果"
        Width="600"
        Height="440"
        MinWidth="460"
        MinHeight="340"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="OcrResultPane" TargetType="Border" BasedOn="{StaticResource ToolPanelPane}"/>

        <Style x:Key="OcrResultTextBox" TargetType="TextBox" BasedOn="{StaticResource ToolPanelTextBox}"/>
    </Window.Resources>

    <Grid Margin="10,52,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource OcrResultPane}">
            <TextBox x:Name="txtResult"
                     Style="{StaticResource OcrResultTextBox}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     IsReadOnly="False"
                     VerticalScrollBarVisibility="Auto"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceAltBrush}"
                    CornerRadius="{StaticResource CornerRadiusMedium}"
                    Padding="10,0"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <TextBlock x:Name="txtProvider"
                           Text="提供商: Windows Local"
                           FontSize="{StaticResource FontSizeHint}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Opacity="0.86"/>
            </Border>

            <Button x:Name="btnClose"
                    Grid.Column="1"
                    Style="{StaticResource ToolPanelSecondaryButton}"
                    Click="BtnClose_Click">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14"
                             Height="14"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconX}"
                                  Stroke="{StaticResource TextPrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="关闭"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnCopy"
                    Grid.Column="2"
                    Style="{StaticResource ToolPanelPrimaryButton}"
                    Click="BtnCopy_Click"
                    Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14"
                             Height="14"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconCopy}"
                                  Stroke="{StaticResource OnPrimaryBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="{StaticResource TransparentBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="复制"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
