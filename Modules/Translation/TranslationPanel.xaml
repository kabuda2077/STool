<Window x:Class="STool.Modules.Translation.TranslationPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:STool.Core"
        Style="{StaticResource ModernWindow}"
        core:ModernWindowChrome.ShowTopmostButton="True"
        core:ModernWindowChrome.TitleBarExtraTopPadding="True"
        Title="翻译" Width="720" Height="560" MinWidth="560" MinHeight="480"
        PreviewKeyDown="Window_PreviewKeyDown" WindowStartupLocation="CenterScreen">
    <Grid Margin="12,52,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="1.08*" MinHeight="180"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource ToolPanelPane}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBox x:Name="txtSource" Style="{StaticResource ToolPanelTextBox}"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="翻译原文" TextChanged="TxtSource_TextChanged"/>
                    <TextBlock x:Name="srcWatermark" Text="输入或粘贴要翻译的内容"
                               Style="{StaticResource HintText}" IsHitTestVisible="False" VerticalAlignment="Top"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbMode" Style="{StaticResource SunkenComboBox}"
                              Width="170" HorizontalAlignment="Left" AutomationProperties.Name="翻译方向"
                              SelectionChanged="CmbMode_SelectionChanged">
                        <ComboBoxItem Tag="zh-en" Content="中文 ↔ 英文"/>
                        <ComboBoxItem Tag="auto-zh" Content="自动 → 中文"/>
                        <ComboBoxItem Tag="auto-en" Content="自动 → 英文"/>
                        <ComboBoxItem Tag="auto-ja" Content="自动 → 日文"/>
                        <ComboBoxItem Tag="auto-ko" Content="自动 → 韩文"/>
                    </ComboBox>
                    <Button x:Name="btnClearSource" Grid.Column="1" Style="{StaticResource ToolPanelSecondaryButton}"
                            Content="清空" Margin="8,0" IsEnabled="False" Click="BtnClearSource_Click"/>
                    <Button x:Name="btnTranslateSource" Grid.Column="2" Style="{StaticResource ToolPanelPrimaryButton}"
                            Content="翻译" MinWidth="84" IsEnabled="False" ToolTip="翻译 (Ctrl+Enter)"
                            Click="BtnTranslateSource_Click"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Left">
                        <Grid x:Name="providerSegmentGrid" Height="32" ClipToBounds="True">
                            <Border x:Name="providerSlider" Style="{StaticResource SegmentedSlider}">
                                <Border.RenderTransform>
                                    <TransformGroup><ScaleTransform x:Name="providerSliderScale"/><TranslateTransform x:Name="providerSliderTransform"/></TransformGroup>
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnProviderGoogle" Style="{StaticResource SegmentedButton}" Content="谷歌" MinWidth="64" Click="Provider_Click"/>
                                <Button x:Name="btnProviderTencent" Style="{StaticResource SegmentedButton}" Content="腾讯" MinWidth="64" Click="Provider_Click"/>
                                <Button x:Name="btnProviderAi" Style="{StaticResource SegmentedButton}" Content="AI" MinWidth="64" Click="Provider_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Ctrl+Enter 翻译 · Shift+Enter 换行" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource ToolPanelPane}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="btnAccounts" DockPanel.Dock="Right" Style="{StaticResource ToolPanelSecondaryButton}"
                            Content="服务账号" Visibility="Collapsed" Click="BtnAccounts_Click" Margin="8,0,0,0"/>
                    <Button x:Name="btnRetry" DockPanel.Dock="Right" Style="{StaticResource ToolPanelSecondaryButton}"
                            Content="重新翻译" Visibility="Collapsed" Click="BtnTranslateSource_Click" Margin="8,0,0,0"/>
                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="resultStatus" Text="译文" Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"/>
                    </ScrollViewer>
                </DockPanel>
                <Grid Grid.Row="1">
                    <TextBox x:Name="txtTarget" Style="{StaticResource ToolPanelTextBox}" TextWrapping="Wrap"
                             AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="译文" TextChanged="TxtTarget_TextChanged"/>
                    <TextBlock x:Name="tgtWatermark" Text="译文将显示在这里" Style="{StaticResource HintText}"
                               IsHitTestVisible="False" VerticalAlignment="Top"/>
                    <Border x:Name="loadingIndicator" Style="{StaticResource LoadingSpinner}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
                <StackPanel x:Name="actionBar" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" IsEnabled="False">
                    <Button x:Name="btnCopyHide" Style="{StaticResource ToolPanelSecondaryButton}" Content="复制并关闭"
                            ToolTip="复制并关闭 (Ctrl+Shift+C)" Click="BtnCopyHide_Click"/>
                    <Button x:Name="btnCopyInput" Style="{StaticResource ToolPanelSecondaryButton}" Content="粘贴到原窗口"
                            Margin="8,0" Click="BtnCopyInput_Click"/>
                    <Button x:Name="btnCopyOnly" Style="{StaticResource ToolPanelSecondaryButton}" Content="复制" MinWidth="72" Click="BtnCopyOnly_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
