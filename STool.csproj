<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\STool.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF 管理入口，不调用 WinForms ApplicationConfiguration.Initialize。
         DPI 必须由启动清单声明；仅豁免 WinForms 对该清单的建议，不禁用其他分析器。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\STool.ico" />
    <EmbeddedResource Include="Modules\LanTransfer\Web\**\*" />
  </ItemGroup>

  <!-- 测试项目位于 Tests/ 子目录,排除以免被主项目的默认通配符重复编译 -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Page Remove="Tests\**\*.xaml" />
    <None Remove="Tests\**\*" />
  </ItemGroup>

</Project>
