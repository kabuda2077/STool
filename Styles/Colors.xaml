<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral palette with a quieter blue accent matching the app icon -->
    <Color x:Key="PrimaryColor">#2554C7</Color>
    <Color x:Key="PrimaryHoverColor">#2F64E6</Color>
    <Color x:Key="PrimaryPressedColor">#1E3F99</Color>
    <Color x:Key="PrimarySoftColor">#F0F5FF</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F7F7F8</Color>
    <Color x:Key="SettingsContentColor">#FFFFFF</Color>
    <Color x:Key="SettingsSectionColor">#F4F5F7</Color>
    <Color x:Key="SettingsSectionBorderColor">#EEF1F5</Color>
    <Color x:Key="SettingsInputColor">#FFFFFF</Color>
    <Color x:Key="SettingsItemHoverColor">#FAFBFC</Color>
    <Color x:Key="SettingsSidebarColor">#F6F7F9</Color>
    <Color x:Key="SettingsSidebarHoverColor">#EEF1F5</Color>
    <Color x:Key="SettingsSidebarSelectedColor">#E7ECF5</Color>
    <Color x:Key="SettingsSidebarTextColor">#343A46</Color>
    <Color x:Key="SettingsSidebarTextMutedColor">#6B7280</Color>
    <Color x:Key="SettingsSidebarFocusColor">#2554C7</Color>
    <Color x:Key="BorderColor">#E7E7EA</Color>
    <Color x:Key="TextPrimaryColor">#18181B</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="SuccessColor">#2DC472</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="ErrorHoverColor">#EF4444</Color>
    <Color x:Key="ErrorPressedColor">#B91C1C</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SettingsContentBrush" Color="{StaticResource SettingsContentColor}"/>
    <SolidColorBrush x:Key="SettingsSectionBrush" Color="{StaticResource SettingsSectionColor}"/>
    <SolidColorBrush x:Key="SettingsSectionBorderBrush" Color="{StaticResource SettingsSectionBorderColor}"/>
    <SolidColorBrush x:Key="SettingsInputBrush" Color="{StaticResource SettingsInputColor}"/>
    <SolidColorBrush x:Key="SettingsItemHoverBrush" Color="{StaticResource SettingsItemHoverColor}"/>
    <SolidColorBrush x:Key="SettingsSidebarBrush" Color="{StaticResource SettingsSidebarColor}"/>
    <SolidColorBrush x:Key="SettingsSidebarHoverBrush" Color="{StaticResource SettingsSidebarHoverColor}"/>
    <SolidColorBrush x:Key="SettingsSidebarSelectedBrush" Color="{StaticResource SettingsSidebarSelectedColor}"/>
    <SolidColorBrush x:Key="SettingsSidebarTextBrush" Color="{StaticResource SettingsSidebarTextColor}"/>
    <SolidColorBrush x:Key="SettingsSidebarTextMutedBrush" Color="{StaticResource SettingsSidebarTextMutedColor}"/>
    <SolidColorBrush x:Key="SettingsSidebarFocusBrush" Color="{StaticResource SettingsSidebarFocusColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorHoverBrush" Color="{StaticResource ErrorHoverColor}"/>
    <SolidColorBrush x:Key="ErrorPressedBrush" Color="{StaticResource ErrorPressedColor}"/>

    <!-- Overlay for modals/screenshots -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000"/>
    <SolidColorBrush x:Key="ScreenshotOverlayBackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ScreenshotMaskBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="ScreenshotSizeLabelBrush" Color="#D21A1A1A"/>
    <!-- 截图原位译文在浅色背景上的文字色，比正文色略浅，贴近原图文字观感 -->
    <SolidColorBrush x:Key="ScreenshotTranslationDarkTextBrush" Color="#4E4E58"/>
    <SolidColorBrush x:Key="PinnedCloseBackgroundBrush" Color="#8C3F3F46"/>
    <Color x:Key="AnnotationDefaultColor">#DC2626</Color>

    <!-- 截图标注调色板：仅用于标注笔迹与文字，不作为界面配色。
         红色即 AnnotationDefaultColor；其余覆盖常见标注需求（醒目、提示、通过、说明、深浅底色）。 -->
    <Color x:Key="AnnotationOrangeColor">#F97316</Color>
    <Color x:Key="AnnotationYellowColor">#FACC15</Color>
    <Color x:Key="AnnotationGreenColor">#16A34A</Color>
    <Color x:Key="AnnotationBlueColor">#2563EB</Color>
    <Color x:Key="AnnotationBlackColor">#18181B</Color>
    <Color x:Key="AnnotationWhiteColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="AnnotationRedBrush" Color="{StaticResource AnnotationDefaultColor}"/>
    <SolidColorBrush x:Key="AnnotationOrangeBrush" Color="{StaticResource AnnotationOrangeColor}"/>
    <SolidColorBrush x:Key="AnnotationYellowBrush" Color="{StaticResource AnnotationYellowColor}"/>
    <SolidColorBrush x:Key="AnnotationGreenBrush" Color="{StaticResource AnnotationGreenColor}"/>
    <SolidColorBrush x:Key="AnnotationBlueBrush" Color="{StaticResource AnnotationBlueColor}"/>
    <SolidColorBrush x:Key="AnnotationBlackBrush" Color="{StaticResource AnnotationBlackColor}"/>
    <SolidColorBrush x:Key="AnnotationWhiteBrush" Color="{StaticResource AnnotationWhiteColor}"/>

    <!-- Standard shadow for all elevated surfaces -->
    <Color x:Key="ShadowColor">#0B1220</Color>
    <DropShadowEffect x:Key="StandardShadow" Color="{StaticResource ShadowColor}" BlurRadius="12" ShadowDepth="1" Direction="270" Opacity="0.035" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="PaneShadow" Color="{StaticResource ShadowColor}" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.015" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="MenuShadow" Color="{StaticResource ShadowColor}" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.10" RenderingBias="Quality"/>

</ResourceDictionary>
