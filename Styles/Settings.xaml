<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:core="clr-namespace:STool.Core"
                    xmlns:views="clr-namespace:STool.Views"
                    xmlns:settings="clr-namespace:STool.Views.Settings"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- stool-magpie.html 的设置页专用尺寸、颜色和运动，不改变工具窗口的资源。 -->
    <FontFamily x:Key="SettingsBodyFontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="SettingsPickerFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <sys:Double x:Key="SettingsBodyFontSize">13</sys:Double>
    <sys:Double x:Key="SettingsFieldFontSize">12.5</sys:Double>
    <sys:Double x:Key="SettingsEditorLabelFontSize">12</sys:Double>
    <sys:Double x:Key="SettingsSummaryFontSize">11.5</sys:Double>
    <sys:Double x:Key="SettingsHintFontSize">11</sys:Double>
    <sys:Double x:Key="SettingsDetailHeaderFontSize">12</sys:Double>
    <SolidColorBrush x:Key="SettingsForegroundBrush" Color="#1C1C21"/>
    <SolidColorBrush x:Key="SettingsSecondaryBrush" Color="#4B4B53"/>
    <SolidColorBrush x:Key="SettingsControlBrush" Color="#63636B"/>
    <SolidColorBrush x:Key="SettingsMutedBrush" Color="#85858D"/>
    <SolidColorBrush x:Key="SettingsFaintBrush" Color="#B9B9C2"/>
    <SolidColorBrush x:Key="SettingsChevronBrush" Color="#B9B9C2"/>
    <SolidColorBrush x:Key="SettingsPillBrush" Color="#F1F1F4"/>
    <SolidColorBrush x:Key="SettingsPillHoverBrush" Color="#E9E9EE"/>
    <SolidColorBrush x:Key="SettingsEditorBrush" Color="#F9F9FB"/>
    <SolidColorBrush x:Key="SettingsRowLineBrush" Color="#ECECF0"/>
    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="SettingsAccentSoftBrush" Color="#EEEDFD"/>
    <SolidColorBrush x:Key="SettingsErrorBrush" Color="#D64545"/>
    <SolidColorBrush x:Key="SettingsSuccessBrush" Color="#189A58"/>
    <SolidColorBrush x:Key="SettingsElevationEdgeBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="SettingsMenuEdgeBrush" Color="#1A14161E"/>
    <DropShadowEffect x:Key="SettingsNavigationShadow" Color="Black" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.14" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="SettingsSwitchShadow" Color="Black" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.25" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="SettingsMenuShadow" Color="#14161E" BlurRadius="44" ShadowDepth="16" Direction="270" Opacity="0.16" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="SettingsMenuNearShadow" Color="#14161E" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.06" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="SettingsTooltipShadow" Color="#20242C" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.10" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="SettingsTooltipNearShadow" Color="#20242C" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.04" RenderingBias="Quality"/>
    <Geometry x:Key="SettingsChevronGeometry">M5.5,6.5 L8,9 L10.5,6.5</Geometry>
    <Geometry x:Key="SettingsEyeGeometry">M2,12 C2,12 6,6 12,6 C18,6 22,12 22,12 C22,12 18,18 12,18 C6,18 2,12 2,12 Z M14.5,12 A2.5,2.5 0 1 1 9.5,12 A2.5,2.5 0 1 1 14.5,12</Geometry>
    <Geometry x:Key="SettingsEyeOffGeometry">M3,3 L21,21 M10.6,6.1 A12,12 0 0 1 12,6 C18,6 22,12 22,12 A18,18 0 0 1 19,15.5 M6.2,6.2 A22,22 0 0 0 2,12 C2,12 6,18 12,18 A12,12 0 0 0 17.8,16.2 M10,10 A2.8,2.8 0 0 0 14,14</Geometry>
    <Storyboard x:Key="SettingsPillNormalMotion"><ColorAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 120}"><SplineColorKeyFrame KeyTime="100%" Value="#F1F1F4" KeySpline="0.25,0.1,0.25,1"/></ColorAnimationUsingKeyFrames></Storyboard>
    <Storyboard x:Key="SettingsPillHoverMotion"><ColorAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 120}"><SplineColorKeyFrame KeyTime="100%" Value="#E9E9EE" KeySpline="0.25,0.1,0.25,1"/></ColorAnimationUsingKeyFrames></Storyboard>
    <Storyboard x:Key="SettingsTextNormalMotion">
        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 120}"><SplineColorKeyFrame KeyTime="100%" Value="Transparent" KeySpline="0.25,0.1,0.25,1"/></ColorAnimationUsingKeyFrames>
        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 120}"><SplineColorKeyFrame KeyTime="100%" Value="#63636B" KeySpline="0.25,0.1,0.25,1"/></ColorAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="SettingsTextHoverMotion">
        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 120}"><SplineColorKeyFrame KeyTime="100%" Value="#F1F1F4" KeySpline="0.25,0.1,0.25,1"/></ColorAnimationUsingKeyFrames>
        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 120}"><SplineColorKeyFrame KeyTime="100%" Value="#1C1C21" KeySpline="0.25,0.1,0.25,1"/></ColorAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="SettingsInputNormalMotion"><ColorAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 120}"><SplineColorKeyFrame KeyTime="100%" Value="#E3E3E8" KeySpline="0.25,0.1,0.25,1"/></ColorAnimationUsingKeyFrames></Storyboard>
    <Storyboard x:Key="SettingsInputFocusMotion"><ColorAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 120}"><SplineColorKeyFrame KeyTime="100%" Value="#4F46E5" KeySpline="0.25,0.1,0.25,1"/></ColorAnimationUsingKeyFrames></Storyboard>

    <Style x:Key="SettingsFocusVisual" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
            <Border Margin="-5" BorderBrush="{StaticResource SettingsAccentBrush}" BorderThickness="2" CornerRadius="8"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsChevronPath" TargetType="Path">
        <Setter Property="Data" Value="{StaticResource SettingsChevronGeometry}"/>
        <Setter Property="Stroke" Value="{StaticResource SettingsChevronBrush}"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}" Value="True"><Setter Property="Stroke" Value="{StaticResource SettingsMutedBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="True"><Setter Property="Stroke" Value="{StaticResource SettingsMutedBrush}"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="SettingsDownChevron"><Viewbox Width="12" Height="12"><Canvas Width="16" Height="16"><Path Style="{StaticResource SettingsChevronPath}"/></Canvas></Viewbox></DataTemplate>
    <DataTemplate x:Key="SettingsSelectionText"><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate>

    <Style x:Key="SettingsNavigationButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SettingsControlBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource SettingsBodyFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource SettingsFieldFontSize}"/>
        <Setter Property="Padding" Value="12,0"/><Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" TextElement.Foreground="{TemplateBinding Foreground}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsNavigationSlider" TargetType="Border">
        <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource SettingsElevationEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="0.5"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Height" Value="24"/>
        <Setter Property="Effect" Value="{StaticResource SettingsNavigationShadow}"/><Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SettingsBodyFontSize}"/><Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource SettingsForegroundBrush}"/><Setter Property="LineHeight" Value="20"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingsEditorLabel" TargetType="TextBlock" BasedOn="{StaticResource SettingsFieldLabel}">
        <Setter Property="FontSize" Value="{StaticResource SettingsEditorLabelFontSize}"/><Setter Property="Foreground" Value="{StaticResource SettingsSecondaryBrush}"/><Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="SettingsHintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SettingsHintFontSize}"/><Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="17"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
    <Style x:Key="SettingsAccountSummary" TargetType="TextBlock" BasedOn="{StaticResource SettingsHintText}">
        <Setter Property="FontSize" Value="{StaticResource SettingsSummaryFontSize}"/><Setter Property="Height" Value="16"/><Setter Property="LineHeight" Value="16"/>
        <Setter Property="Margin" Value="0,2,0,0"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <!-- WPF BlockLineHeight 的 Segoe UI 基线比浏览器高0.81 DIP；只修正字面位置。 -->
        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-0.81"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SettingsHintText}">
        <Setter Property="FontFamily" Value="{StaticResource SettingsPickerFontFamily}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="LineHeight" Value="20"/><Setter Property="Margin" Value="0,-4,0,0"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    </Style>
    <Style x:Key="SettingsFlatSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SettingsSectionBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SettingsSectionBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="0"/><Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="settings:SettingsRoundedClip.Enabled" Value="True"/>
    </Style>

    <Style x:Key="SettingsActionButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SettingsBodyFontFamily}"/><Setter Property="FontSize" Value="{StaticResource SettingsEditorLabelFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource SettingsControlBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="7,0"/><Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" TextElement.Foreground="{TemplateBinding Foreground}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SettingsTextHoverMotion}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource SettingsTextNormalMotion}"/></Trigger.ExitActions></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SettingsPillHoverBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Wait"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsChipRemoveButton" TargetType="Button" BasedOn="{StaticResource SettingsActionButton}"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Padding" Value="0"/></Style>
    <Geometry x:Key="SettingsChipRemoveGeometry">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Style x:Key="SettingsPasswordRevealButton" TargetType="Button" BasedOn="{StaticResource SettingsActionButton}">
        <Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}"/><Setter Property="Width" Value="24"/><Setter Property="Height" Value="23"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" CornerRadius="4"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SettingsPillBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsReuseCheckBox" TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource SettingsEditorLabelFontSize}"/><Setter Property="Foreground" Value="{StaticResource SettingsSecondaryBrush}"/>
        <Setter Property="MinHeight" Value="24"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border x:Name="Box" Width="14" Height="14" BorderThickness="1" BorderBrush="#929299" Background="White" CornerRadius="2" VerticalAlignment="Center"><Path x:Name="Check" Visibility="Hidden" Data="M2,6 L5,9 L10,3" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border>
                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource SettingsAccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource SettingsBodyFontFamily}"/><Setter Property="FontSize" Value="{StaticResource SettingsFieldFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource SettingsForegroundBrush}"/><Setter Property="Background" Value="White"/>
        <Setter Property="Height" Value="27"/><Setter Property="MinHeight" Value="27"/><Setter Property="Padding" Value="9,0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource SettingsSectionBorderBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource SettingsAccentBrush}"/><Setter Property="SelectionBrush" Value="{StaticResource SettingsAccentBrush}"/><Setter Property="SelectionTextBrush" Value="{StaticResource SettingsForegroundBrush}"/><Setter Property="SelectionOpacity" Value="0.12"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Grid>
                <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="1,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                <TextBlock x:Name="Placeholder" Text="{Binding Path=(settings:SettingsInput.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource SettingsMutedBrush}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SettingsInputFocusMotion}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource SettingsInputNormalMotion}"/></Trigger.ExitActions></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="FontFamily" Value="{StaticResource SettingsBodyFontFamily}"/><Setter Property="FontSize" Value="{StaticResource SettingsFieldFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource SettingsForegroundBrush}"/><Setter Property="Background" Value="White"/>
        <Setter Property="Height" Value="27"/><Setter Property="MinHeight" Value="27"/><Setter Property="Padding" Value="9,0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{StaticResource SettingsSectionBorderBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource SettingsAccentBrush}"/><Setter Property="SelectionBrush" Value="{StaticResource SettingsAccentBrush}"/><Setter Property="SelectionTextBrush" Value="{StaticResource SettingsForegroundBrush}"/><Setter Property="SelectionOpacity" Value="0.12"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
            <Grid><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/><ScrollViewer x:Name="PART_ContentHost" Margin="1,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Grid>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SettingsInputFocusMotion}"/></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource SettingsInputNormalMotion}"/></Trigger.ExitActions></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsHotkeyBox" TargetType="core:HotkeyBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource SettingsBodyFontFamily}"/><Setter Property="FontSize" Value="{StaticResource SettingsEditorLabelFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource SettingsSecondaryBrush}"/><Setter Property="Background" Value="{StaticResource SettingsPillBrush}"/>
        <Setter Property="Height" Value="25"/><Setter Property="Width" Value="108"/><Setter Property="Padding" Value="10,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{StaticResource SettingsAccentBrush}"/><Setter Property="SelectionTextBrush" Value="{StaticResource SettingsForegroundBrush}"/><Setter Property="SelectionOpacity" Value="0.12"/><Setter Property="CaretBrush" Value="{StaticResource SettingsAccentBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="core:HotkeyBox">
            <Grid>
                <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                <TextBlock x:Name="RecordingLabel" Text="{TemplateBinding RecordingText}" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SettingsPillHoverBrush}"/></Trigger>
                <Trigger Property="IsRecording" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SettingsAccentSoftBrush}"/><Setter TargetName="Root" Property="BorderThickness" Value="1"/><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource SettingsAccentBrush}"/>
                    <Setter TargetName="PART_ContentHost" Property="Opacity" Value="0"/><Setter TargetName="RecordingLabel" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <ControlTemplate x:Key="SettingsComboToggle" TargetType="ToggleButton">
        <Grid><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/><ContentControl ContentTemplate="{StaticResource SettingsDownChevron}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/></Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="False"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Root" Property="BorderBrush" Value="Transparent"/><MultiTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SettingsPillNormalMotion}"/></MultiTrigger.EnterActions></MultiTrigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsChecked" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Root" Property="BorderBrush" Value="Transparent"/><MultiTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SettingsPillHoverMotion}"/></MultiTrigger.EnterActions></MultiTrigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/><Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SettingsPillHoverMotion}"/></Trigger.EnterActions></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="SettingsComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource SettingsPickerFontFamily}"/><Setter Property="FontSize" Value="{StaticResource SettingsEditorLabelFontSize}"/><Setter Property="Foreground" Value="{StaticResource SettingsForegroundBrush}"/>
        <Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Root" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center"/>
                    <Viewbox x:Name="Check" Grid.Column="1" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden"><Canvas Width="24" Height="24"><Path Data="M5,12 L9,16 L19,6" Stroke="{StaticResource SettingsForegroundBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SettingsPillBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="FontWeight" Value="Medium"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource SettingsPickerFontFamily}"/><Setter Property="FontSize" Value="{StaticResource SettingsFieldFontSize}"/><Setter Property="Foreground" Value="{StaticResource SettingsSecondaryBrush}"/>
        <Setter Property="Height" Value="25"/><Setter Property="MinHeight" Value="25"/><Setter Property="Background" Value="{StaticResource SettingsPillBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="ScrollViewer.CanContentScroll" Value="False"/><Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboItem}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/><Setter Property="settings:SettingsPickerPlacement.Enabled" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="Picker" Template="{StaticResource SettingsComboToggle}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{StaticResource SettingsSelectionText}" IsHitTestVisible="False" Margin="8,0,26,0" VerticalAlignment="Center"/>
                <Border x:Name="EditorBorder" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed"/>
                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" FocusVisualStyle="{StaticResource SettingsFocusVisual}" Background="Transparent" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" BorderThickness="0" Padding="0" Margin="9,0" VerticalAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Collapsed" CaretBrush="{StaticResource SettingsAccentBrush}" SelectionBrush="{StaticResource SettingsAccentBrush}" SelectionTextBrush="{StaticResource SettingsForegroundBrush}" SelectionOpacity="0.12"/>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Custom" PopupAnimation="None">
                    <Border Margin="46,24,46,50" Effect="{StaticResource SettingsMenuShadow}">
                        <Border x:Name="Menu" Background="White" CornerRadius="9" BorderBrush="{StaticResource SettingsMenuEdgeBrush}" BorderThickness="0.5" Padding="3.5" Effect="{StaticResource SettingsMenuNearShadow}" MinWidth="{Binding Path=(settings:SettingsPickerPlacement.MenuMinWidth), RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="330">
                            <ScrollViewer MaxHeight="272" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                    <Setter TargetName="Picker" Property="Visibility" Value="Collapsed"/><Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="EditorBorder" Property="Visibility" Value="Visible"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource SettingsSectionBorderBrush}"/><Setter Property="Height" Value="27"/><Setter Property="MinHeight" Value="27"/><Setter Property="Foreground" Value="{StaticResource SettingsForegroundBrush}"/>
                </Trigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEditable" Value="True"/><Condition Property="IsKeyboardFocusWithin" Value="True"/></MultiTrigger.Conditions><Setter TargetName="EditorBorder" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}"/></MultiTrigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource SettingsSecondaryBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="SettingsSwitch" TargetType="CheckBox">
        <Setter Property="Focusable" Value="True"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="32" Height="19" CornerRadius="10"><Border.Background><SolidColorBrush Color="#E3E3E8"/></Border.Background>
                <Border x:Name="Thumb" Width="15" Height="15" CornerRadius="8" Background="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2" Effect="{StaticResource SettingsSwitchShadow}"><Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform></Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 200}"><SplineColorKeyFrame KeyTime="100%" Value="#1C1C21" KeySpline="0.2,0.8,0.2,1"/></ColorAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Duration="{settings:SettingsMotion 220}"><SplineDoubleKeyFrame KeyTime="100%" Value="13" KeySpline="0.2,0.8,0.2,1"/></DoubleAnimationUsingKeyFrames>
                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                        <ColorAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Duration="{settings:SettingsMotion 200}"><SplineColorKeyFrame KeyTime="100%" Value="#E3E3E8" KeySpline="0.2,0.8,0.2,1"/></ColorAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Duration="{settings:SettingsMotion 220}"><SplineDoubleKeyFrame KeyTime="100%" Value="0" KeySpline="0.2,0.8,0.2,1"/></DoubleAnimationUsingKeyFrames>
                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="SettingsAccountDetailLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SettingsDetailHeaderFontSize}"/><Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True"><Setter Property="Foreground" Value="{StaticResource SettingsSecondaryBrush}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SettingsAccountHeader" TargetType="ToggleButton">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource SettingsForegroundBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Root" MinHeight="52" Padding="14,7,12,7" Background="Transparent">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,10,0"/>
                    <ContentControl x:Name="Chevron" Grid.Column="1" Width="18" Height="22" ContentTemplate="{StaticResource SettingsDownChevron}" VerticalAlignment="Center" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5"><ContentControl.RenderTransform><RotateTransform Angle="-90"/></ContentControl.RenderTransform></ContentControl>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SettingsEditorBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="{settings:SettingsMotion 180}"><SplineDoubleKeyFrame KeyTime="100%" Value="0" KeySpline="0.2,0.8,0.2,1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="{settings:SettingsMotion 180}"><SplineDoubleKeyFrame KeyTime="100%" Value="-90" KeySpline="0.2,0.8,0.2,1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsExpander" TargetType="Expander">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <StackPanel><ToggleButton Style="{StaticResource SettingsAccountHeader}" Content="{TemplateBinding Header}" AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Border x:Name="Detail" Visibility="Collapsed" Background="{StaticResource SettingsEditorBrush}" BorderBrush="{StaticResource SettingsRowLineBrush}" BorderThickness="0,1,0,0" SnapsToDevicePixels="True"><ContentPresenter ContentSource="Content"/></Border>
            </StackPanel>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Detail" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsCompactExpander" TargetType="Expander">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <StackPanel>
                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}" Cursor="Hand" HorizontalAlignment="Left" FocusVisualStyle="{StaticResource SettingsFocusVisual}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Height="28" Background="Transparent"><ContentControl x:Name="Chevron" ContentTemplate="{StaticResource SettingsDownChevron}" VerticalAlignment="Center" Margin="0,0,5,0" RenderTransformOrigin="0.5,0.5"><ContentControl.RenderTransform><RotateTransform Angle="-90"/></ContentControl.RenderTransform></ContentControl>
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="{StaticResource SettingsHintFontSize}" TextElement.Foreground="{StaticResource SettingsControlBrush}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="{settings:SettingsMotion 160}"><SplineDoubleKeyFrame KeyTime="100%" Value="0" KeySpline="0.2,0.8,0.2,1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" Duration="{settings:SettingsMotion 160}"><SplineDoubleKeyFrame KeyTime="100%" Value="-90" KeySpline="0.2,0.8,0.2,1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Border x:Name="Detail" Visibility="Collapsed" Style="{StaticResource SettingsFlatSection}" Margin="0,6,0,8"><ContentPresenter ContentSource="Content"/></Border>
            </StackPanel>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Detail" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsToolTip" TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource SettingsBodyFontFamily}"/><Setter Property="FontSize" Value="{StaticResource SettingsHintFontSize}"/><Setter Property="Foreground" Value="{StaticResource SettingsSecondaryBrush}"/>
        <Setter Property="Placement" Value="Bottom"/><Setter Property="HorizontalOffset" Value="-21"/><Setter Property="VerticalOffset" Value="-12"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
            <Border Margin="24,16,24,32" Effect="{StaticResource SettingsTooltipShadow}"><Border Background="White" BorderBrush="{StaticResource SettingsSectionBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="11,8" MaxWidth="320" Effect="{StaticResource SettingsTooltipNearShadow}">
                <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" FontSize="{StaticResource SettingsHintFontSize}" LineHeight="17" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SettingsSecondaryBrush}"/>
            </Border></Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsSavedToast" TargetType="Border">
        <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="7"/><Setter Property="BorderBrush" Value="{StaticResource SettingsElevationEdgeBrush}"/><Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Padding" Value="10.5,4.5"/><Setter Property="Effect" Value="{StaticResource SettingsNavigationShadow}"/><Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style x:Key="SettingsCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="{StaticResource SettingsMutedBrush}"/><Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SettingsPillBrush}"/><Setter Property="Foreground" Value="{StaticResource SettingsForegroundBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsCloseButton" TargetType="Button" BasedOn="{StaticResource SettingsCaptionButton}">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#C9372C"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsWindow" TargetType="Window" BasedOn="{StaticResource ModernWindow}">
        <Setter Property="Background" Value="{StaticResource SettingsContentBrush}"/><Setter Property="Foreground" Value="{StaticResource SettingsForegroundBrush}"/><Setter Property="FontFamily" Value="{StaticResource SettingsBodyFontFamily}"/><Setter Property="FontSize" Value="{StaticResource SettingsBodyFontSize}"/>
        <Setter Property="UseLayoutRounding" Value="False"/>
        <Setter Property="shell:WindowChrome.WindowChrome"><Setter.Value><shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
            <Border x:Name="PART_WindowRoot" Background="{StaticResource SettingsContentBrush}"><Grid><AdornerDecorator><ContentPresenter/></AdornerDecorator>
                <StackPanel x:Name="PART_CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="PART_MinimizeButton" Style="{StaticResource SettingsCaptionButton}" AutomationProperties.Name="最小化"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconMinimize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
                    <Button x:Name="PART_MaximizeButton" Style="{StaticResource SettingsCaptionButton}" AutomationProperties.Name="最大化"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path x:Name="PART_MaximizeIcon" Data="{StaticResource IconMaximize}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                    <Button x:Name="PART_CloseButton" Style="{StaticResource SettingsCloseButton}" AutomationProperties.Name="关闭"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconX}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                </StackPanel>
            </Grid></Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
