<Window x:Class="STool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:STool.Views"
        xmlns:settings="clr-namespace:STool.Views.Settings"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource SettingsWindow}"
        Title="STool 设置" Width="660" Height="560" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <PopupAnimation x:Key="{x:Static SystemParameters.ToolTipPopupAnimationKey}">None</PopupAnimation>
        <Style TargetType="ToolTip" BasedOn="{StaticResource SettingsToolTip}"/>
    </Window.Resources>
    <Grid Background="{StaticResource SettingsContentBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Left" AutomationProperties.Name="STool" MouseLeftButtonUp="Brand_Click"
                       Cursor="Hand" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Run Text="STool"/><Run Text="." Foreground="{StaticResource SettingsAccentBrush}"/>
            </TextBlock>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="28"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border x:Name="navigationSlider" Style="{StaticResource SettingsNavigationSlider}" HorizontalAlignment="Left"
                        Margin="2,0,0,0" Visibility="Hidden">
                    <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="navigationScale"/><TranslateTransform x:Name="navigationTranslate"/></TransformGroup></Border.RenderTransform>
                </Border>
                <StackPanel x:Name="navigationTabs" Orientation="Horizontal" Margin="2" SizeChanged="NavigationTabs_SizeChanged">
                    <settings:SettingsNavigationButton x:Name="btnGeneralSettings" Click="BtnGeneralSettings_Click" Style="{StaticResource SettingsNavigationButton}" Content="通用"/>
                    <settings:SettingsNavigationButton x:Name="btnClipboardSettings" Click="BtnClipboardSettings_Click" Style="{StaticResource SettingsNavigationButton}" Content="剪贴板"/>
                    <settings:SettingsNavigationButton x:Name="btnOcrSettings" Click="BtnOcrSettings_Click" Style="{StaticResource SettingsNavigationButton}" Content="文字识别"/>
                    <settings:SettingsNavigationButton x:Name="btnTranslationSettings" Click="BtnTranslationSettings_Click" Style="{StaticResource SettingsNavigationButton}" Content="翻译"/>
                    <settings:SettingsNavigationButton x:Name="btnAccountsSettings" Click="BtnAccountsSettings_Click" Style="{StaticResource SettingsNavigationButton}" Content="服务账号"/>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel x:Name="saveFailure" Grid.Row="1" Margin="16,0,16,8" Visibility="Collapsed">
            <TextBlock x:Name="saveError" Foreground="{StaticResource SettingsErrorBrush}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel Margin="0,6,0,0">
                <Button x:Name="retrySave" Content="重试保存" Click="RetrySave_Click" Style="{StaticResource SettingsActionButton}"/>
                <Button Content="放弃未保存修改" Click="DiscardSave_Click" Style="{StaticResource SettingsActionButton}" Margin="8,0,0,0"/>
            </WrapPanel>
        </StackPanel>
        <ScrollViewer x:Name="contentScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" FocusVisualStyle="{x:Null}" SizeChanged="ContentScroll_SizeChanged"
                      PreviewMouseWheel="ContentScroll_PreviewMouseWheel" ScrollChanged="ContentScroll_ScrollChanged">
            <settings:SettingsContentGrid x:Name="contentPanel" HorizontalAlignment="Left" Margin="16,2,16,22"/>
        </ScrollViewer>
        <Border x:Name="savedToast" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SettingsSavedToast}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=saveStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
            </Border.Style>
            <TextBlock x:Name="saveStatus" FontSize="11" Foreground="{StaticResource SettingsSecondaryBrush}" LineHeight="16.5" LineStackingStrategy="BlockLineHeight" AutomationProperties.LiveSetting="Polite"/>
        </Border>
    </Grid>
</Window>
