<Window x:Class="STool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:STool.Core"
        Style="{StaticResource ModernWindow}"
        core:ModernWindowChrome.HideTitleText="True"
        Title="STool 设置"
        Width="710"
        Height="560"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource TransparentBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SettingsSidebarBrush}"
                BorderBrush="{StaticResource SettingsSectionBorderBrush}"
                BorderThickness="0,0,0.5,0"
                Padding="8,56,8,16">
            <StackPanel>
                <Button x:Name="btnGeneralSettings"
                        Click="BtnGeneralSettings_Click"
                        Style="{StaticResource NavigationButton}"
                        Content="通用"/>

                <Button x:Name="btnClipboardSettings"
                        Click="BtnClipboardSettings_Click"
                        Style="{StaticResource NavigationButton}"
                        Margin="0,6,0,0"
                        Content="剪贴板"/>

                <Button x:Name="btnAccountsSettings"
                        Click="BtnAccountsSettings_Click"
                        Style="{StaticResource NavigationButton}"
                        Margin="0,6,0,0"
                        Content="服务账号"/>

                <Button x:Name="btnOcrSettings"
                        Click="BtnOcrSettings_Click"
                        Style="{StaticResource NavigationButton}"
                        Margin="0,6,0,0"
                        Content="OCR"/>

                <Button x:Name="btnTranslationSettings"
                        Click="BtnTranslationSettings_Click"
                        Style="{StaticResource NavigationButton}"
                        Margin="0,6,0,0"
                        Content="翻译"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource SettingsContentBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Margin="24,8,24,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="pageTitle" FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="{StaticResource FontWeightStrong}" AutomationProperties.HeadingLevel="Level1"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="saveStatus" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="retrySave" Content="重试保存" Click="RetrySave_Click"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="contentScroll"
                              Grid.Row="2"
                              Margin="0"
                              VerticalScrollBarVisibility="Hidden"
                              Background="{StaticResource TransparentBrush}"
                              FocusVisualStyle="{x:Null}"
                              SizeChanged="ContentScroll_SizeChanged"
                              ScrollChanged="ContentScroll_ScrollChanged"
                              PreviewMouseWheel="ContentScroll_PreviewMouseWheel"
                              Padding="0">
                    <Grid x:Name="contentPanel"
                          HorizontalAlignment="Left"
                          Margin="6,0,6,18"/>
                </ScrollViewer>

                <ScrollBar x:Name="contentScrollBar"
                           Grid.Row="2"
                           Orientation="Vertical"
                           Width="6"
                           MinWidth="6"
                           Margin="0,4,2,4"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Visibility="Collapsed"
                           ValueChanged="ContentScrollBar_ValueChanged"/>
            </Grid>
        </Border>
    </Grid>
</Window>
